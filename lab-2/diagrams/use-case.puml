  usecase "UC-07 Відхилити запит" as UC07
  usecase "UC-08 Призначити Editor" as UC08
  usecase "UC-09 Завантажити результат" as UC09
  usecase "UC-10 Позначити замовлення готовим" as UC10
  usecase "UC-11 Отримати результат" as UC11
  usecase "UC-12 Підтвердити оплату і закрити замовлення" as UC12
