sequenceDiagram
    autonumber
    actor M as Mediator
    participant S as RequestService
    participant O as Order
    participant P as Payment
    participant T as Translator
    participant R as Request

    M->>+S: sendRequests(orderId)
    S->>+O: getOrder(orderId)
    O-->>-S: order (created, uk → en)
    S->>+P: getFirstHalfPayment(orderId)
    P-->>-S: payment (paid)
    S->>+T: findByLanguages(sourceLanguageId, targetLanguageId)
    T-->>-S: translators A, C
    loop each translator
        S->>+R: createRequest(orderId, translatorId)
        R-->>-S: request (pending)
    end
    S->>+O: updateStatus(orderId, "sent_to_translators")
    O-->>-S: ok
    S-->>-M: requestsSent(2)