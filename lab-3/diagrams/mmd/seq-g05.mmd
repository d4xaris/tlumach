sequenceDiagram
    autonumber
    actor M as Mediator
    participant S as RequestService
    participant O as Order

    M->>+S: sendRequests(orderId)
    S->>+O: getOrder(orderId)
    O-->>-S: order (in_progress)
    opt status is in_progress
        S-->>M: error, order already in progress
    end
    deactivate S