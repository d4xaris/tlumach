stateDiagram-v2
    [*] --> created
    created --> created: перша половина не paid або немає перекладачів (UC-05, UC-06)
    created --> sent_to_translators: перша половина paid і є перекладачі (UC-05)
    sent_to_translators --> in_progress: один Request accepted
    sent_to_translators --> cancelled: ніхто не взявся, перша половина refunded
    in_progress --> in_editing: Mediator призначив Editor

    state in_editing {
        state fork1 <<fork>>
        state join1 <<join>>
        [*] --> fork1
        fork1 --> editing_work
        fork1 --> second_payment_wait
        editing_work --> join1: результат завантажено
        second_payment_wait --> join1: друга половина paid
        second_payment_wait --> second_payment_overdue: минув due_date
        second_payment_overdue --> join1: клієнт сплатив
        join1 --> [*]
    }

    in_editing --> ready: join виконано
    second_payment_overdue --> cancelled: N днів без відповіді клієнта
    ready --> confirmed: Mediator підтвердив оплату і видав результат
    confirmed --> closed: Mediator закрив замовлення
    closed --> [*]
    cancelled --> [*]